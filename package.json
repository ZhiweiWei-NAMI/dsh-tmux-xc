{
  "name": "dsh-tmux-xc",
  "version": "0.1.1",
  "description": "Manage remote tmux tasks across DeepSeek Harness conversations: exact-pane references, read-only snapshots, and approval-controlled agent actions.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiweiWei-NAMI/dsh-tmux-xc.git"
  },
  "homepage": "https://github.com/ZhiweiWei-NAMI/dsh-tmux-xc#readme",
  "bugs": {
    "url": "https://github.com/ZhiweiWei-NAMI/dsh-tmux-xc/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tmux",
    "ssh",
    "remote",
    "cross-conversation",
    "agent-tools",
    "terminal-snapshot"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.0.0"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "pack:release": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist"
  }
}
